{
  "entities": {
    "UserProfile": {
      "collection": "users",
      "fields": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "JournalEntry": {
      "collection": "users/{userId}/entries",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "mood": { "type": "string" },
        "tags": { "type": "array", "items": "string" },
        "summary": { "type": "string" },
        "insights": { "type": "array", "items": "string" },
        "actionItems": { "type": "array", "items": "string" },
        "messageCount": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "JournalMessage": {
      "collection": "users/{userId}/entries/{entryId}/messages",
      "fields": {
        "id": { "type": "string" },
        "entryId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "sequence": { "type": "number" },
        "turnIndex": { "type": "number" },
        "createdAt": { "type": "timestamp" }
      }
    },
    "UserInsight": {
      "collection": "users/{userId}/insights",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "entryFingerprint": { "type": "string" },
        "entryCount": { "type": "number" },
        "dateRange": { "type": "object" },
        "recurringThemes": { "type": "array" },
        "moodAnalysis": { "type": "object" },
        "accomplishments": { "type": "array" },
        "challenges": { "type": "array" },
        "growthAreas": { "type": "array" },
        "reflectionPrompts": { "type": "array" },
        "disclaimer": { "type": "string" },
        "generatedAt": { "type": "timestamp" }
      }
    }
  }
}
